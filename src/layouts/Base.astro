---
// Gabarit commun des pages du site : <head>, en-tête avec le menu, fil d’Ariane, contenu de la page (<slot />), puis pied de page.
// La frise (index.astro) ne l’utilise pas encore : elle le rejoindra au lot 4 (étape 4e).
// D’ici là, le <head> est écrit aux deux endroits : un changement des polices, de la description ou de la canonique
// se fait dans les deux. Le script du thème, lui, est commun (ScriptTheme.astro).
//
// Ce que la page lui passe :
//   titre        le titre de la page, affiché dans l’onglet du navigateur
//   description  une phrase qui résume la page, montrée par les moteurs de recherche sous le titre ; facultative
//   rubrique     l’entrée du menu à mettre en noir ("mouvements", "artistes"…), c’est-à-dire la « cle » d’une page de src/lib/site.js
//   ariane       le fil d’Ariane : une liste de { texte, href } ; le dernier, sans href, est la page affichée
import { PAGES_FIXES } from "../lib/site.js";
import ScriptTheme from "../components/ScriptTheme.astro";
import BoutonTheme from "../components/BoutonTheme.astro";

const { titre, description = "", rubrique, ariane = [] } = Astro.props;

// Adresse canonique : l’adresse officielle de la page, toujours sur le site de production (champ site d’astro.config.mjs)
// et toujours avec la barre finale, comme les liens de adresse(). Une version de test, ou une adresse tapée sans barre
// finale, renvoie ainsi Google vers la même page, au lieu de lui faire compter deux pages identiques.
const chemin = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonique = new URL(chemin, Astro.site);

// Le menu et le pied de page (D18) : la liste des pages fixes est dans src/lib/site.js
const MENU = PAGES_FIXES.filter((p) => p.menu);
const PIED = PAGES_FIXES.filter((p) => p.pied);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{titre} · L’art moderne</title>
  <!-- Sans description, pas de balise : le moteur de recherche choisit alors lui-même un extrait de la page -->
  {description && <meta name="description" content={description}>}
  <link rel="canonical" href={canonique}>
  <!-- Thème clair ou sombre, posé avant l’affichage : script commun avec la frise (ScriptTheme.astro) -->
  <ScriptTheme />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap" rel="stylesheet">
  <!-- style.css apporte les variables (couleurs, polices, mode sombre) et le bouton de thème ; pages.css, l’apparence des pages -->
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/pages.css">
</head>
<body class="page">
  <header class="entete-site">
    <a class="marque" href="/"><strong>L’art moderne</strong><span>1874–1960 · Une histoire en mouvements</span></a>
    <nav class="menu" aria-label="Rubriques du site">
      {MENU.map((p) => (
        <a href={p.href} aria-current={p.cle === rubrique ? "page" : undefined}>{p.texte}</a>
      ))}
    </nav>
    <!-- Le même bouton que sur la frise (BoutonTheme.astro) : le choix vaut pour tout le site -->
    <BoutonTheme />
  </header>

  <main class="contenu">
    {ariane.length > 0 && (
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol>
          {ariane.map((x) => (
            <li>{x.href ? <a href={x.href}>{x.texte}</a> : <span aria-current="page">{x.texte}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>

  <!-- Le lien de la page affichée est marqué aria-current : comparé à « chemin », qui a toujours sa barre finale -->
  <footer class="pied-site">
    <nav aria-label="Pied de page">
      <ul>
        {PIED.map((p) => (
          <li><a href={p.href} aria-current={p.href === chemin ? "page" : undefined}>{p.texte}</a></li>
        ))}
      </ul>
    </nav>
  </footer>
</body>
</html>