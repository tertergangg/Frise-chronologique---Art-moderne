---
// Gabarit commun des pages du site : <head>, en-tête avec le menu, fil d’Ariane, contenu de la page (<slot />), puis pied de page.
// La frise (index.astro) ne l’utilise pas encore : elle recevra le menu au lot 4.
// D’ici là, le <head> est écrit aux deux endroits : un changement des polices ou du script du thème se fait dans les deux.
//
// Ce que la page lui passe :
//   titre        le titre de la page, affiché dans l’onglet du navigateur
//   description  une phrase qui résume la page, montrée par les moteurs de recherche sous le titre ; facultative
//   rubrique     l’entrée du menu à mettre en noir ("mouvements", "artistes"…)
//   ariane       le fil d’Ariane : une liste de { texte, href } ; le dernier, sans href, est la page affichée
const { titre, description = "", rubrique, ariane = [] } = Astro.props;

// Adresse canonique : l’adresse officielle de la page, toujours sur le site de production (champ site d’astro.config.mjs)
// et toujours avec la barre finale, comme les liens de adresse(). Une version de test, ou une adresse tapée sans barre
// finale, renvoie ainsi Google vers la même page, au lieu de lui faire compter deux pages identiques.
const chemin = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonique = new URL(chemin, Astro.site);

// Le menu du site (D18). Comprendre arrive en phase 4 : une rubrique n’entre dans le menu qu’avec son contenu.
const MENU = [
  { rubrique: "frise", texte: "Frise", href: "/" },
  { rubrique: "mouvements", texte: "Mouvements", href: "/mouvements/" },
  { rubrique: "artistes", texte: "Artistes", href: "/artistes/" },
  { rubrique: "oeuvres", texte: "Œuvres", href: "/oeuvres/" },
];

// Le pied de page (D18) : les pages utiles à tout le site, qui ne sont pas des rubriques du menu
const PIED = [
  { texte: "À propos", href: "/a-propos/" },
  { texte: "Plan du site", href: "/plan-du-site/" },
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{titre} · L’art moderne</title>
  <!-- Sans description, pas de balise : le moteur de recherche choisit alors lui-même un extrait de la page -->
  {description && <meta name="description" content={description}>}
  <link rel="canonical" href={canonique}>
  <!-- Thème clair ou sombre, posé avant l’affichage pour éviter un flash du mauvais thème (copie du script de index.astro).
       Les pages n’ont pas encore de bouton de thème : elles suivent le choix fait sur la frise, ou le réglage de l’appareil. -->
  <script is:inline>
    (() => {
      let theme = null;
      try { theme = localStorage.getItem("theme"); } catch (err) { /* stockage indisponible */ }
      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap" rel="stylesheet">
  <!-- style.css apporte les variables (couleurs, polices, mode sombre) ; pages.css, l’apparence des pages -->
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/pages.css">
</head>
<body class="page">
  <header class="entete-site">
    <a class="marque" href="/"><strong>L’art moderne</strong><span>1874–1960 · Une histoire en mouvements</span></a>
    <nav class="menu" aria-label="Rubriques du site">
      {MENU.map((r) => (
        <a href={r.href} aria-current={r.rubrique === rubrique ? "page" : undefined}>{r.texte}</a>
      ))}
    </nav>
  </header>

  <main class="contenu">
    {ariane.length > 0 && (
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol>
          {ariane.map((x) => (
            <li>{x.href ? <a href={x.href}>{x.texte}</a> : <span aria-current="page">{x.texte}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>

  <!-- Le lien de la page affichée est marqué aria-current : comparé à « chemin », qui a toujours sa barre finale -->
  <footer class="pied-site">
    <nav aria-label="Pied de page">
      <ul>
        {PIED.map((p) => (
          <li><a href={p.href} aria-current={p.href === chemin ? "page" : undefined}>{p.texte}</a></li>
        ))}
      </ul>
    </nav>
  </footer>
</body>
</html>