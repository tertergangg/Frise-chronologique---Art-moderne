---
// Gabarit commun des pages du site : <head>, en-tête (EnteteSite.astro), fil d’Ariane, contenu de la page (<slot />), puis pied de page.
// La frise (index.astro) ne l’utilise pas : son corps est trop différent (ni body.page, ni pages.css, ni pied de page, D55).
// Elle partage avec les pages le contenu du <head> (TeteHtml.astro) et l’en-tête (EnteteSite.astro).
//
// Ce que la page lui passe :
//   titre        le titre de la page, affiché dans l’onglet du navigateur, suivi du nom du site
//   description  une phrase qui résume la page, montrée par les moteurs de recherche sous le titre ; facultative
//   rubrique     l’entrée du menu à mettre en noir ("mouvements", "artistes"…), c’est-à-dire la « cle » d’une page de src/lib/site.js
//   ariane       le fil d’Ariane : une liste de { texte, href } ; le dernier, sans href, est la page affichée
import { PAGES_FIXES } from "../lib/site.js";
import TeteHtml from "../components/TeteHtml.astro";
import EnteteSite from "../components/EnteteSite.astro";

const { titre, description = "", rubrique, ariane = [] } = Astro.props;

// L’adresse de la page, toujours avec la barre finale, comme les liens de adresse(). Elle sert à l’adresse canonique
// (TeteHtml.astro) et à mettre en noir la page affichée, dans le menu comme dans le pied de page.
const chemin = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;

// Le pied de page (D18) : la liste des pages fixes est dans src/lib/site.js
const PIED = PAGES_FIXES.filter((p) => p.pied);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <!-- Contenu du <head> commun avec la frise ; pages.css, l’apparence des pages, est chargé après style.css (D39) -->
  <TeteHtml titre={`${titre} · L’art moderne`} description={description} chemin={chemin}>
    <link rel="stylesheet" href="/pages.css">
  </TeteHtml>
</head>
<body class="page">
  <EnteteSite rubrique={rubrique} chemin={chemin} />

  <main class="contenu">
    {ariane.length > 0 && (
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol>
          {ariane.map((x) => (
            <li>{x.href ? <a href={x.href}>{x.texte}</a> : <span aria-current="page">{x.texte}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <slot />
  </main>

  <!-- Le lien de la page affichée est marqué aria-current : comparé à « chemin », qui a toujours sa barre finale -->
  <footer class="pied-site">
    <nav aria-label="Pied de page">
      <ul>
        {PIED.map((p) => (
          <li><a href={p.href} aria-current={p.href === chemin ? "page" : undefined}>{p.texte}</a></li>
        ))}
      </ul>
    </nav>
  </footer>
</body>
</html>