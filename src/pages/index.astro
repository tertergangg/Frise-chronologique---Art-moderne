---
// Page de la frise.
// style.css et le dossier images se trouvent dans le dossier public : Astro les publie tels quels.
// Le script de la frise, src/scripts/app.js, est traité par Astro : il importe les données de src/data/frise.json et la librairie marked.
import ScriptTheme from "../components/ScriptTheme.astro";
import EnteteSite from "../components/EnteteSite.astro";

// Adresse canonique de la frise : toujours « / » sur le site de production, même en vue mouvement (/?mouvement=…),
// qui est la même page avec un autre affichage
const canonique = new URL("/", Astro.site);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>L’art moderne, 1874–1960</title>
  <!-- Phrase montrée par les moteurs de recherche sous le titre (aussi écrite dans Base.astro pour les pages, jusqu’au lot 4) -->
  <meta name="description" content="Une frise chronologique interactive de l’art moderne (1874–1960) : mouvements, artistes et œuvres, pour voir ce qui se passe en même temps.">
    <link rel="canonical" href={canonique}>
  <!-- Thème clair ou sombre, posé avant l’affichage : script commun aux pages (ScriptTheme.astro) -->
  <ScriptTheme />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Le titre de la page, pour les lecteurs d’écran : l’en-tête n’affiche que la marque compacte du site (D54) -->
  <h1 class="visuellement-cache">L’art moderne, 1874–1960 : la frise chronologique</h1>
  <!-- L’en-tête commun du site (EnteteSite.astro). Sa seconde ligne, propre à la frise : les mouvements, que remplit app.js,
       puis l’étoile « Œuvres majeures seulement », un bouton à deux états. Son nom complet est dans aria-label et dans la bulle ;
       deux libellés, le long sur ordinateur, le court sur téléphone (style.css n’en affiche qu’un). -->
  <EnteteSite chemin="/" surFrise>
    <div class="ligne-frise">
      <nav id="sommaire" class="filtres" aria-label="Aller à un mouvement"></nav>
      <button type="button" id="majeures" class="bouton-majeures" aria-pressed="true" aria-label="Œuvres majeures seulement"
        data-bulle="Œuvres majeures seulement"><span aria-hidden="true">★</span><span class="long">Œuvres majeures</span><span class="court">Majeures</span></button>
    </div>
  </EnteteSite>

  <div id="bandeau" class="bandeau" hidden></div>

  <main id="defile" class="defile" tabindex="0" aria-label="Frise chronologique">
    <div id="toile" class="toile"></div>
  </main>

  <nav id="decennies" class="decennies" aria-label="Aller à une décennie"></nav>

  <div id="bulle" class="bulle" role="tooltip" hidden></div>

  <!-- Le panneau affiche une fiche ou l’Index -->
  <aside id="panneau" class="panneau" aria-live="polite" hidden>
    <div id="poignee" class="poignee" role="separator" aria-orientation="vertical" aria-label="Redimensionner le panneau" tabindex="0"></div>
    <!-- C’est ce bloc qui défile, et non le panneau : la poignée reste ainsi en place -->
    <div id="interieur-panneau" class="interieur-panneau">
      <button type="button" id="fermer" class="fermer" aria-label="Fermer le panneau">×</button>
      <div id="contenu-panneau"></div>
    </div>
  </aside>

  <!-- Image d’une œuvre en grand, ouverte depuis sa fiche. app.js y place l’image au moment du clic. -->
  <dialog id="visionneuse" class="visionneuse" aria-label="Image en grand">
    <button type="button" class="fermer" aria-label="Fermer l’image">×</button>
    <img id="image-grande" alt="">
  </dialog>

  <!-- Sans « is:inline » : Astro traite le script, résout ses imports (les données et marked) et le publie dans dist/_astro/ -->
  <script src="../scripts/app.js"></script>
</body>
</html>