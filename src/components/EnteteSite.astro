---
// En-tête du site : le titre, le menu (les rubriques, puis « À propos » à l’écart, D55), puis à droite
// « Au hasard », l’Index et le bouton de thème (D54). Utilisé par Base.astro ; la frise le recevra à l’étape 4d.
// « Au hasard » et l’Index sont des liens vers la frise, qui tire l’œuvre ou ouvre l’Index (D53) :
// les pages n’ont ni les données ni le panneau.
//
// Ce que la page lui passe :
//   rubrique   la rubrique en cours, mise en noir dans le menu (la « cle » d’une page de src/lib/site.js) ; facultative
//   chemin     l’adresse de la page, avec sa barre finale : elle met en noir une page fixe du menu, comme À propos
import { PAGES_FIXES, ANCRES_FRISE } from "../lib/site.js";
import BoutonTheme from "./BoutonTheme.astro";

const { rubrique, chemin } = Astro.props;

const MENU = PAGES_FIXES.filter((p) => p.menu);
// Une entrée est « en cours » si c’est la rubrique de la page, ou si c’est la page elle-même
const enCours = (p) => p.cle === rubrique || p.href === chemin;
---
<header class="entete-site">
  <a class="marque" href="/"><strong>L’art moderne</strong><span>1874–1960 · Une histoire en mouvements</span></a>
  <nav class="menu" aria-label="Menu du site">
    {MENU.map((p) => (
      <a href={p.href} class={p.aPart ? "a-part" : undefined} aria-current={enCours(p) ? "page" : undefined}>{p.texte}</a>
    ))}
  </nav>
  <div class="outils-site">
    <!-- Mêmes classes et mêmes deux libellés que les boutons de la frise (style.css n’affiche qu’un libellé) -->
    <a class="hasard" href={`/#${ANCRES_FRISE.hasard}`}><span class="long">Une œuvre au hasard</span><span class="court">Au hasard</span></a>
    <a class="bouton-index" href={`/#${ANCRES_FRISE.index}`}><span class="trois-traits" aria-hidden="true"></span>Index</a>
    <!-- Le même bouton que sur la frise (BoutonTheme.astro) : le choix vaut pour tout le site -->
    <BoutonTheme />
  </div>
</header>